  "invariants": {
    "no_script_may_hardcode_provider_worlds_graphs_rhos_regimes_or_seed_ranges": true,
    "scripts_must_read_phase5_configs": true,
    "query_float_identity_uses_rho_label_not_stringified_float": true,
