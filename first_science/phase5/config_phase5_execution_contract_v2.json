    "step0_gate_failure_is_cell_level_exclusion": true,
    "m3_rank1_n_at_least_100_for_paired_scoring_diagnostic": true
  },
  "supersedes": "config_phase5_execution_contract_v1.json",
  "engineering_smoke": {
